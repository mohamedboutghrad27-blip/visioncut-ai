# Neon Postgres — pooled connection (application traffic, goes through PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Postgres — direct/unpooled connection (Prisma migrations, prisma db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Auth session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional: public app URL (set to your Vercel domain after first deploy)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------------------
# Speech-to-text (auto subtitles) — provider-agnostic core (src/lib/transcribe.ts)
# ---------------------------------------------------------------------------
# TRANSCRIBE_PROVIDER: auto | zai | openai | groq | lemonfox | deepgram |
#                      gladia | assemblyai | elevenlabs | custom
#   auto    = custom endpoint (if TRANSCRIBE_BASE_URL set), else Z.ai platform (sandbox)
#   custom  = any OpenAI-compatible /v1/audio/transcriptions host via TRANSCRIBE_BASE_URL
# Example (OpenAI Whisper):
#   TRANSCRIBE_PROVIDER="openai"
#   TRANSCRIBE_API_KEY="sk-..."
# Example (Groq Whisper):
#   TRANSCRIBE_PROVIDER="groq"
#   TRANSCRIBE_API_KEY="gsk_..."
# Example (any OpenAI-compatible endpoint):
#   TRANSCRIBE_PROVIDER="custom"
#   TRANSCRIBE_BASE_URL="https://api.example.com/v1"
#   TRANSCRIBE_API_KEY="..."
# Optional model override (whisper-1, whisper-large-v3, nova-3, scribe_v1, ...)
# TRANSCRIBE_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# Script/storyboard generation (AI panel) — provider-agnostic core (src/lib/llm.ts)
# ---------------------------------------------------------------------------
# SCRIPT_PROVIDER: auto | zai | custom
#   auto    = custom host (if configured), else Z.ai platform (sandbox)
#   custom  = any OpenAI-compatible /v1/chat/completions host
# Example (custom OpenAI-compatible host):
#   SCRIPT_PROVIDER="custom"
#   CUSTOM_LLM_BASE_URL="https://api.example.com/v1"
#   CUSTOM_LLM_API_KEY="..."
#   CUSTOM_LLM_MODEL="..."

# ---------------------------------------------------------------------------
# Text-to-video generation (AI panel) — provider-agnostic core (src/lib/video.ts)
# ---------------------------------------------------------------------------
# VIDEO_PROVIDER: auto | zai | fal | wavespeed | kie | pixverse | higgsfield
#   auto       = try providers with a key (higgsfield -> fal -> wavespeed -> kie -> pixverse),
#                else Z.ai (sandbox); skipped providers are surfaced as warnings in the UI
#   higgsfield = https://higgsfield.ai queue API — VIDEO_API_KEY is the full "keyId:keySecret"
#                pair from console.higgsfield.ai (header "Authorization: Key keyId:keySecret")
#                Browse models: GET https://api.higgsfield.ai/models (18 text-to-video models:
#                WAN 3.0, Seedance 2.5, Kling v3.0, Hailuo 2.3, PixVerse v6, LTX 2.5, ...)
#   fal        = https://fal.ai queue API (keys look like "<uuid>:<hex>", header "Authorization: Key")
#   wavespeed  = https://wavespeed.ai v3 predictions API (header "Authorization: Bearer")
#   kie        = https://kie.ai jobs API (header "Authorization: Bearer")
#   pixverse   = https://platform.pixverse.ai openapi (header "API-KEY")
#   zai        = Z.ai platform SDK (sandbox only)
# Example (Higgsfield):
#   VIDEO_PROVIDER="higgsfield"
#   VIDEO_API_KEY="<keyId>:<keySecret>"
# Optional model overrides (plus per-provider keys: each wins over VIDEO_API_KEY
# for its own platform, so several platforms can coexist and `auto` tries all):
#   HIGGSFIELD_API_KEY / FAL_API_KEY / WAVESPEED_API_KEY / KIE_API_KEY / PIXVERSE_API_KEY
#   HIGGSFIELD_VIDEO_MODEL="alibaba/wan-3.0/text-to-video"
#   FAL_VIDEO_MODEL="fal-ai/wan-t2v"
#   WAVESPEED_VIDEO_MODEL="wavespeed-ai/wan-2.1-t2v-480p"
#   KIE_VIDEO_MODEL="veo3-fast"
#   PIXVERSE_VIDEO_MODEL="v4.5"
