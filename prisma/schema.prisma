generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String
  avatarColor  String          @default("#8b5cf6")
  isDemo       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  projects     Project[]
  resets       PasswordReset[]
  mediaFiles   MediaFile[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  aspectRatio String   @default("16:9")
  data        String   @default("{}")
  thumbnail   String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Cloud backup of editor media blobs (chunked to fit serverless body limits).
// MediaFile.id mirrors the client asset id (as_...).
model MediaFile {
  id        String       @id
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  chunks    MediaChunk[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model MediaChunk {
  fileId String
  idx    Int
  data   Bytes
  file   MediaFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, idx])
}
